    <altera:altera_module_parameters>
      <ipxact:parameters>
        <ipxact:parameter parameterId="ID" type="int">
          <ipxact:name>ID</ipxact:name>
          <ipxact:displayName>Core ID</ipxact:displayName>
          <ipxact:value>0</ipxact:value>
        </ipxact:parameter>
        <ipxact:parameter parameterId="PWM_FREQUENCY_HZ" type="int">
          <ipxact:name>PWM_FREQUENCY_HZ</ipxact:name>
          <ipxact:displayName>PWM Frequency (Hz)</ipxact:displayName>
          <ipxact:value>5000</ipxact:value>
        </ipxact:parameter>
        <ipxact:parameter parameterId="INTERNAL_SYSMONE" type="int">
          <ipxact:name>INTERNAL_SYSMONE</ipxact:name>
          <ipxact:displayName>Use internal SYSMON (0=external temp_in; must be 0 on Agilex)</ipxact:displayName>
          <ipxact:value>0</ipxact:value>
        </ipxact:parameter>
        <ipxact:parameter parameterId="AVG_POW" type="int">
          <ipxact:name>AVG_POW</ipxact:name>
          <ipxact:displayName>Tacho Averaging Window (2^N samples, max 7)</ipxact:displayName>
          <ipxact:value>7</ipxact:value>
        </ipxact:parameter>
        <ipxact:parameter parameterId="PWM_ACTIVE_LOW" type="int">
          <ipxact:name>PWM_ACTIVE_LOW</ipxact:name>
          <ipxact:displayName>PWM active-low (0=high=full speed; 1=inverting carrier)</ipxact:displayName>
          <ipxact:value>0</ipxact:value>
        </ipxact:parameter>
        <ipxact:parameter parameterId="TEMP_00_H" type="int">
          <ipxact:name>TEMP_00_H</ipxact:name>
          <ipxact:displayName>Temp threshold: below = PWM 0% (deg C)</ipxact:displayName>
          <ipxact:value>5</ipxact:value>
        </ipxact:parameter>
        <ipxact:parameter parameterId="TEMP_25_L" type="int">
          <ipxact:name>TEMP_25_L</ipxact:name>
          <ipxact:displayName>Temp threshold: above = PWM 25% (deg C)</ipxact:displayName>
          <ipxact:value>20</ipxact:value>
        </ipxact:parameter>
        <ipxact:parameter parameterId="TEMP_25_H" type="int">
          <ipxact:name>TEMP_25_H</ipxact:name>
          <ipxact:displayName>Temp threshold: below = PWM 25% (deg C)</ipxact:displayName>
          <ipxact:value>40</ipxact:value>
        </ipxact:parameter>
        <ipxact:parameter parameterId="TEMP_50_L" type="int">
          <ipxact:name>TEMP_50_L</ipxact:name>
          <ipxact:displayName>Temp threshold: above = PWM 50% (deg C)</ipxact:displayName>
          <ipxact:value>60</ipxact:value>
        </ipxact:parameter>
        <ipxact:parameter parameterId="TEMP_50_H" type="int">
          <ipxact:name>TEMP_50_H</ipxact:name>
          <ipxact:displayName>Temp threshold: below = PWM 50% (deg C)</ipxact:displayName>
          <ipxact:value>70</ipxact:value>
        </ipxact:parameter>
        <ipxact:parameter parameterId="TEMP_75_L" type="int">
          <ipxact:name>TEMP_75_L</ipxact:name>
          <ipxact:displayName>Temp threshold: above = PWM 75% (deg C)</ipxact:displayName>
          <ipxact:value>80</ipxact:value>
        </ipxact:parameter>
        <ipxact:parameter parameterId="TEMP_75_H" type="int">
          <ipxact:name>TEMP_75_H</ipxact:name>
          <ipxact:displayName>Temp threshold: below = PWM 75% (deg C)</ipxact:displayName>
          <ipxact:value>90</ipxact:value>
        </ipxact:parameter>
        <ipxact:parameter parameterId="TEMP_00_L" type="int">
          <ipxact:name>TEMP_00_L</ipxact:name>
          <ipxact:displayName>Temp threshold: above = PWM 100% (deg C); CSR name TEMP_100_L</ipxact:displayName>
          <ipxact:value>95</ipxact:value>
        </ipxact:parameter>
        <ipxact:parameter parameterId="TACHO_T25" type="int">
          <ipxact:name>TACHO_T25</ipxact:name>
          <ipxact:displayName>Tacho half-period at PWM 25% (100 MHz clock cycles)</ipxact:displayName>
          <ipxact:value>1470000</ipxact:value>
        </ipxact:parameter>
        <ipxact:parameter parameterId="TACHO_T50" type="int">
          <ipxact:name>TACHO_T50</ipxact:name>
          <ipxact:displayName>Tacho half-period at PWM 50% (100 MHz clock cycles)</ipxact:displayName>
          <ipxact:value>820000</ipxact:value>
        </ipxact:parameter>
        <ipxact:parameter parameterId="TACHO_T75" type="int">
          <ipxact:name>TACHO_T75</ipxact:name>
          <ipxact:displayName>Tacho half-period at PWM 75% (100 MHz clock cycles)</ipxact:displayName>
          <ipxact:value>480000</ipxact:value>
        </ipxact:parameter>
        <ipxact:parameter parameterId="TACHO_T100" type="int">
          <ipxact:name>TACHO_T100</ipxact:name>
          <ipxact:displayName>Tacho half-period at PWM 100% (100 MHz clock cycles)</ipxact:displayName>
          <ipxact:value>340000</ipxact:value>
        </ipxact:parameter>
        <ipxact:parameter parameterId="TACHO_TOL_PERCENT" type="int">
          <ipxact:name>TACHO_TOL_PERCENT</ipxact:name>
          <ipxact:displayName>Tacho tolerance (%)</ipxact:displayName>
          <ipxact:value>25</ipxact:value>
        </ipxact:parameter>
      </ipxact:parameters>
